+    assert harness_calls[8] == release.checkout_ref_argv(str(harness_dir), "main")
+    assert harness_calls[9] == release.pull_argv(str(harness_dir), "main")
+    assert ["gh", "pr", "create", "--title", "pyproject: bump to 0.2.0 to match the tag",
